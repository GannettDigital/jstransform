      "transform": {
        "cumulo": {
          "from": [
            {
              "jsonPath": "$.dates"
            }
          ]
        }
      }
    },
    "requiredDate": {
      "type": "string",
      "format": "date",
      "transform": {
        "cumulo": {
          "from": [
